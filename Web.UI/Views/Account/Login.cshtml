@model LoginDto
@{
    ViewData["Title"] = "Giriş Formu";
}
<div class="row">
    <div class="col-md-4 mx-auto">
        <div class="card shadow my-5">
            <div class="card-body">
                <h4 class="text-center mb-5">Giriş Formu</h4>
                <form method="post" class="mb-5">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-floating mb-4">
                        <input asp-for="Email" class="form-control" />
                        <label asp-for="Email"></label>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-4">
                        <input asp-for="Password" class="form-control" />
                        <label asp-for="Password"></label>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>
                    <button type="submit" class="btn btn-success w-100">Giriş Yap</button>
                </form>
                <div class="text-center text-muted small">
                    Hesabınız yok mu?
                    <a asp-action="register" asp-controller="account" class="link-primary fw-bold text-decoration-none">Kayıt olun!</a>
                </div>
            </div>
        </div>
    </div>
</div>