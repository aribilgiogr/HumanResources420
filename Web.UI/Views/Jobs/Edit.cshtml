@model JobPostingUpdateDto
@{
    ViewData["Title"] = "İlan Düzenle";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm text-bg-light">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="text-muted mb-0">İlan Bilgileri</h5>
                    <a asp-action="index" asp-controller="jobs" class="btn btn-outline-secondary btn-sm">
                        Listeye Dön
                    </a>
                </div>
            </div>
            <div class="card-body">
                <form asp-action="edit" asp-controller="jobs" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <input asp-for="Id" type="hidden" />

                    <div class="form-floating mb-4">
                        <input asp-for="Title" class="form-control" />
                        <label asp-for="Title"></label>
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <textarea asp-for="Description" class="form-control"></textarea>
                        <label asp-for="Description"></label>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Location" class="form-control" />
                        <label asp-for="Location"></label>
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="ExpirationDate" class="form-control" />
                        <label asp-for="ExpirationDate"></label>
                        <span asp-validation-for="ExpirationDate" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-4">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <button type="submit" class="btn btn-primary px-4">Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
