@model JobPostingDetailDto

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <div class="row align-items-center">
                        <div class="col-md-10">
                            <h2 class="mb-0">@Model.Title</h2>
                            <p class="mb-0 mt-1">
                                <small>@Model.CompanyName</small>
                            </p>
                        </div>
                        <div class="col-md-2 text-end">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="detail-item mb-3">
                                <label class="text-muted small">Location</label>
                                <p class="mb-0">
                                    <i class="bi bi-geo-alt text-primary"></i> @Model.Location
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-item mb-3">
                                <label class="text-muted small">Posted On</label>
                                <p class="mb-0">
                                    <i class="bi bi-calendar text-primary"></i> @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="detail-item mb-3">
                                <label class="text-muted small">Expires On</label>
                                <p class="mb-0">
                                    <i class="bi bi-calendar-x text-warning"></i> 
                                    @if (Model.ExpirationDate < DateTime.Now)
                                    {
                                        <span class="text-danger">@Model.ExpirationDate.ToString("MMM dd, yyyy") (Expired)</span>
                                    }
                                    else
                                    {
                                        <span>@Model.ExpirationDate.ToString("MMM dd, yyyy")</span>
                                    }
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-item mb-3">
                                <label class="text-muted small">Applications</label>
                                <p class="mb-0">
                                    <i class="bi bi-file-earmark text-primary"></i> @Model.ApplicationCount @(Model.ApplicationCount == 1 ? "application" : "applications")
                                </p>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="mb-4">
                        <h5 class="mb-3">
                            <i class="bi bi-file-text"></i> Description
                        </h5>
                        <p class="text-muted" style="white-space: pre-wrap;">@Model.Description</p>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-md-6">
                            <label class="text-muted small">Company ID</label>
                            <p>@Model.CompanyId</p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Posting ID</label>
                            <p>@Model.Id</p>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-light">
                    <div class="d-grid gap-2 d-md-flex justify-content-md-between">
                        <a href="@Url.Action("Index")" class="btn btn-secondary">
                            <i class="bi bi-list"></i> Back to List
                        </a>
                        <div>
                            <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-warning">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirm Deletion</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this job posting?</p>
                <p class="text-muted"><strong>@Model.Title</strong> at @Model.CompanyName</p>
                <p class="alert alert-warning mb-0"><small>This action cannot be undone.</small></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-action="Delete" asp-route-id="@Model.Id" style="display:inline;">
                    <button type="submit" class="btn btn-danger">Delete Permanently</button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .detail-item label {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
    }

    .detail-item p {
        font-size: 1.1rem;
    }
</style>
