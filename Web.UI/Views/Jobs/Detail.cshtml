@using Core.Concretes.Enums
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

@model JobPostingDetailDto
@{
    ViewData["Title"] = "İlan: " + Model.Title;
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>@Model.Title</h2>
            <a asp-action="index" asp-controller="jobs" class="btn btn-outline-secondary btn-sm">Listeye Dön</a>
        </div>
        <div class="card shadow-sm">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">İlan Detayı</h5>
                    <span class="badge bg-primary fs-6">@Model.CompanyName</span>
                </div>
                <p class="text-muted small mb-0">
                    @Model.CreatedAt.ToLongDateString() ~ @Model.ExpirationDate.ToLongDateString()
                </p>
            </div>
            <div class="card-body p-4">
                <p class="lead">@Model.Description</p>
            </div>
            <div class="card-footer">
                <div class="row mb-0">
                    <div class="col">
                        <span class="lead"><strong>Konum:</strong> @Model.Location</span>
                    </div>
                    <div class="col-auto">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var u = await UserManager.GetUserAsync(User);
                            if (u!.UserRole == UserType.Employer)
                            {
                                <a class="btn btn-primary btn-sm" asp-action="edit" asp-controller="jobs" asp-route-id="@Model.Id">
                                    Düzenle
                                </a>
                                <form asp-action="delete" asp-controller="jobs" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bu ilanı silmek istediğinize emin misiniz?')">
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        Sil
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="apply" asp-controller="jobs" asp-route-id="@Model.Id" method="post">
                                    <button type="submit" class="btn btn-success btn-sm">
                                        Başvur
                                    </button>
                                </form>
                            }
                        }
                        else
                        {
                            <a class="btn btn-success btn-sm" asp-action="login" asp-controller="account">Giriş Yap</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>